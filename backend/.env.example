PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Production example:
# PORT=5000
# NODE_ENV=production
# FRONTEND_URL=https://tierd.dev,https://www.tierd.dev

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SMTP_HOST=smtp.mailgun.org
# DigitalOcean commonly blocks SMTP 465/587; Mailgun supports 2525.
SMTP_PORT=2525
SMTP_USER=postmaster@mg.example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=postmaster@mg.example.com

TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_SESSION_TTL_HOURS=168

GROQ_API_KEY=place_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
