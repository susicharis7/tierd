{
  "name": "tierd-migration-root",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build && npm --prefix backend ci",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend test && npm --prefix frontend run test",
    "lint": "npm --prefix frontend run lint",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test",
    "lint:frontend": "npm --prefix frontend run lint",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend run start"
  }
}
